# ==============================================================================
# Frappe HR & ERPNext Environment Configuration (.env.example)
# Copy this file to .env and customize values for your deployment.
# ==============================================================================

# Docker Image
IMAGE=gitea.local.coddicted.com/coddicted/frappe-custom-hrms:shubham-issue-38-dockerize-ess-portal-beta-e614532

# Site Settings
SITE_NAME=mysite.localhost

# Host Port Bindings (internal localhost)
EMPLOYEE_PORT=8082
ADMIN_PORT=8083

# Public Reverse Proxy Ports
HTTP_PORT=80
HTTPS_PORT=443

# Database & Admin Passwords (use 24+ random alphanumeric characters in production)
DB_ROOT_PASSWORD=change_this_db_root_password_in_production
ADMIN_PASSWORD=change_this_admin_password_in_production

# Caddy HTTPS Domains & SSL Configuration
PORTAL_DOMAIN=portal.example.com
DESK_DOMAIN=desk.example.com
ACME_EMAIL=admin@example.com

# Offsite Backup Settings (backup.sh)
RCLONE_REMOTE=offsite-encrypted:mysite.localhost
RETENTION_DAYS=14
HEALTHCHECKS_URL=https://hc-ping.com/your-uuid-here
WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url
